# Local application data and SQLite sidecar files
manual_capture/*.db
manual_capture/*.db-shm
manual_capture/*.db-wal

# Local API credentials
.env
.env.*
!.env.example

# Python caches and local environments
__pycache__/
**/__pycache__/
.pytest_cache/
.pytest_tmp/
.venv/
venv/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Codex/workbench state and disposable test artifacts
.workbuddy/
pytest_*/
pytest_*.db
*.pytest.log
manual_capture/server-*.out.log
manual_capture/server-*.err.log

# Local backup and restore-verification artifacts (never source data)
manual_capture/backups/
manual_capture/*.restore-pending*.json
